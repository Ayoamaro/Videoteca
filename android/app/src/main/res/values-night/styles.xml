<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mientras arranca la app: fondo oscuro con el icono en el centro
         (la app siempre empieza en oscuro, también con el móvil en claro). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Detrás de la app mientras funciona. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/fondo</item>
    </style>
</resources>
